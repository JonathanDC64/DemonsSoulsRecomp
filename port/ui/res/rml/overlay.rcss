/* Adapted from Dusklight (CC0) by way of FFCCEOT-Recomp. Adapted for Demon's Souls: toasts and the menu hint only. */
body {
    overflow: visible;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    font-family: var(--font-family-body);
    font-weight: normal;
    font-size: var(--font-size-2xl);
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: stretch;
    z-index: 2;
    pointer-events: none;
}

toast {
    position: absolute;
    border-width: 1dp;
    background-color: rgba(var(--color-surface-rgb), 80%);
}

toast {
    border-color: var(--toast-border-color);
    top: 40dp;
    right: 40dp;
    /* A definite width. With width auto, RmlUi takes the progress bar's 100% as the toast's max-content width and
       stretches the toast across the screen. This one fits a trophy: the 64dp icon, the 16dp gap and toast-body's
       440dp, plus the padding and the border (border-box sizing, global.rcss). */
    width: 570dp;
    max-width: 90%;
    display: flex;
    flex-flow: column;
    border-radius: var(--radius-window);
    overflow: hidden;
    box-shadow: 0 0 15dp 3dp;
    filter: opacity(0);
    transform: scale(0.9);
    transform-origin: center;
    transition: filter transform 0.2s cubic-in-out;
    padding: 18dp var(--space-xl);
    gap: var(--space-sm);
}

toast[open] {
    filter: opacity(1);
    transform: scale(1);
}

toast heading {
    display: flex;
    gap: 18dp;
    align-items: center;
    font-family: var(--font-family-heading);
    font-size: var(--font-size-xl);
    font-weight: bold;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--toast-heading-color);
}

toast heading > toast-title {
    flex: 1 0 auto;
}

toast heading > row {
    flex: 1 0 auto;
    display: flex;
    align-items: center;
    gap: var(--space-xs);
}

toast message {
    display: flex;
    flex-flow: column;
    gap: var(--space-sm);
}

toast message row {
    display: flex;
}

toast message row.muted {
    opacity: 0.5;
}

toast.warning {
    --toast-border-color: var(--color-accent);
    --toast-heading-color: var(--color-accent);
}

toast.menu-notification {
    top: 40dp;
    right: auto;
    bottom: auto;
    left: 50%;
    width: auto;  /* sized to its text (it has no progress bar) */
    max-width: 90%;
    transform: translateX(-50%) scale(0.9);
}

toast.menu-notification[open] {
    transform: translateX(-50%) scale(1);
}

toast.menu-notification message {
    align-items: center;
    text-align: center;
}

toast.menu-notification message row {
    align-items: center;
    gap: 6dp;
}

toast icon {
    width: 1.2em;
    height: 1.2em;
    font-size: 1.2em;
}

/* A toast with an icon (a trophy): the icon left of the heading and the message. */
toast toast-row {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
}

toast toast-body {
    flex: 1 1 auto;  /* the rest of the row, so the grade sits at the right edge; a long name wraps */
    display: flex;
    flex-flow: column;
    gap: var(--space-sm);
    max-width: 440dp;
}

toast toast-icon {
    flex: 0 0 auto;  /* keeps its 64dp when a long name fills the body */
    display: flex;
    align-items: center;
}

toast toast-icon img,
toast toast-icon icon {
    width: 64dp;
    height: 64dp;
}

toast toast-icon icon {
    font-size: 56dp;
}

toast.trophy heading grade icon {
    margin-right: var(--space-xs);
}

toast.trophy message {
    font-weight: bold;
    color: var(--color-accent);
}

toast.trophy grade.platinum {
    color: rgb(180, 205, 225);
}

toast.trophy grade.gold {
    color: rgb(222, 184, 84);
}

toast.trophy grade.silver {
    color: rgb(192, 194, 198);
}

toast.trophy grade.bronze {
    color: rgb(196, 128, 72);
}

@media (max-height: 640dp) {
    toast {
        top: 20dp;
        right: 20dp;
    }

    toast.menu-notification {
        top: 20dp;
    }
}
