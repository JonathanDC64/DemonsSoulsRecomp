/* The start screen. Layout from Dusklight's prelaunch.rcss (CC0) by way of FFCCEOT-Recomp. Adapted for Demon's Souls:
   no background picture (the game boots behind the screen, darkened from the left and at the edges), the title in
   Cinzel over a thin silver rule, and the menu buttons in bone that light up soul-white. Colours from theme.rcss. */
body {
    --color-prelaunch-muted: rgba(var(--color-text-rgb), 62%);
    --menu-button-decorator: horizontal-gradient(rgba(var(--color-interactive-rgb), 0%) rgba(var(--color-interactive-rgb), 0%));
    --menu-button-decorator-hover: horizontal-gradient(rgba(var(--color-interactive-rgb), 16%) rgba(var(--color-interactive-rgb), 0%));

    width: 100%;
    height: 100%;
    font-family: var(--font-family-body);
    font-weight: normal;
    font-size: var(--font-size-2xl);
    color: var(--color-text);
    filter: opacity(0);
    transition: filter 0.8s 0.1s linear-in-out;
    z-index: -1;
}

body[open] {
    filter: opacity(1);
}

/* The game shows through on the right; the menu side is near black. */
prelaunch-gradient {
    position: absolute;
    width: 100%;
    height: 100%;
    decorator: linear-gradient(to right, rgba(var(--color-black-rgb), 96%) 0%, rgba(var(--color-black-rgb), 90%) 42%,
        rgba(var(--color-black-rgb), 60%) 72%, rgba(var(--color-black-rgb), 40%) 100%);
}

prelaunch-vignette {
    position: absolute;
    width: 100%;
    height: 100%;
    decorator: radial-gradient(farthest-corner at 50% 45%, rgba(var(--color-black-rgb), 0%) 45%,
        rgba(var(--color-black-rgb), 75%) 100%);
}

content {
    display: block;
    width: 100%;
    height: 100%;
    filter: opacity(0);
    transition: filter 0.2s linear-in-out;
}

content[open] {
    filter: opacity(1);
}

menu {
    position: absolute;
    left: 104dp;
    top: 50%;
    transform: translateY(-50%);
    width: 640dp;
    display: flex;
    flex-direction: column;
    gap: 56dp;
}

hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
}

hero title-text {
    display: block;
    font-family: var(--font-family-display);
    font-size: 54dp;
    line-height: 1.1;
    letter-spacing: 3dp;
    text-transform: uppercase;
    color: var(--color-accent);
    font-effect: glow(0dp 6dp 0dp 0dp rgba(0, 0, 0, 90%));
}

title-rule {
    display: block;
    width: 460dp;
    height: 1dp;
    decorator: horizontal-gradient(rgba(var(--color-border-rgb), 100%) rgba(var(--color-border-rgb), 0%));
}

eyebrow {
    display: block;
    font-family: var(--font-family-heading);
    font-size: var(--font-size-lg);
    letter-spacing: 6dp;
    text-transform: uppercase;
    color: var(--color-prelaunch-muted);
}

menu-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    align-items: flex-start;
}

#menu-list button {
    width: 380dp;
    height: 50dp;
    padding: var(--space-sm) var(--space-lg);
    border-radius: 0dp;
    border-left-width: 2dp;
    border-left-color: rgba(var(--color-interactive-rgb), 0%);
    box-shadow: none;
    background-color: transparent;
    text-align: left;
    text-transform: uppercase;
    letter-spacing: 2dp;
    font-family: var(--font-family-heading);
    font-size: var(--font-size-5xl);
    font-weight: normal;
    color: var(--color-text);
    cursor: pointer;
    /* A fully transparent gradient as the default state, otherwise a white flash occurs */
    decorator: var(--menu-button-decorator);
}

#menu-list button:disabled {
    opacity: 0.5;
    cursor: default;
    decorator: var(--menu-button-decorator);
}

#menu-list button.anim-done {
    transition: decorator color border-left-color 0.12s linear-in-out;
}

#menu-list button:not(:disabled):hover,
#menu-list button:not(:disabled):focus-visible {
    color: var(--color-white);
    border-left-color: rgba(var(--color-interactive-rgb), 85%);
    font-effect: glow(0dp 6dp 0dp 0dp rgba(var(--color-interactive-rgb), 35%));
    box-shadow: none;
    background-color: transparent;
    decorator: var(--menu-button-decorator-hover);
}

hint-info {
    position: absolute;
    left: 104dp;
    bottom: 64dp;
    font-size: var(--font-size-md);
    color: var(--color-prelaunch-muted);
}

version-info {
    position: absolute;
    right: 64dp;
    bottom: 64dp;
    text-align: right;
    font-size: var(--font-size-md);
    color: var(--color-prelaunch-muted);
}

/* Startup animation */
.intro-item {
    opacity: 0;
    transform: translateY(10dp);
    transition: opacity transform 0.3s 0.1s cubic-in-out;
}

body.animate-in .intro-item {
    opacity: 1;
    transform: translateY(0dp);
}

.delay-0 { transition: opacity transform 0.5s 0.1s cubic-in-out; }
.delay-1 { transition: opacity transform 0.3s 0.3s cubic-in-out; }
.delay-2 { transition: opacity transform 0.3s 0.4s cubic-in-out; }
.delay-3 { transition: opacity transform 0.3s 0.5s cubic-in-out; }
.delay-4 { transition: opacity transform 0.3s 0.6s cubic-in-out; }
.delay-5 { transition: opacity transform 0.3s 0.7s cubic-in-out; }
.delay-6 { transition: opacity transform 0.3s 0.8s cubic-in-out; }
