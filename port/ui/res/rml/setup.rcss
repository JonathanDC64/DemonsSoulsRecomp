/* Written for Demon's Souls. The setup screens (setup_page.cpp, docs/89): the whole window, as the setup design. A
   dark backdrop; the rail on the left with the name, the steps (Your game, Build, Play) and the version; the page on
   the right with a heading, a line under it, panels, buttons and the pad's buttons at the bottom; a question over it
   all. Colours and fonts from theme.rcss. RmlUi draws no element it has no display for, and no bare text in a flex
   row, so every tag here has one and every text sits in its own element. */
body.setup-page {
    --setup-muted: rgba(var(--color-text-rgb), 62%);
    --setup-faint: rgba(var(--color-text-rgb), 38%);
    --setup-line: rgba(var(--color-border-rgb), 14%);
    --setup-line-soft: rgba(var(--color-border-rgb), 35%);
    --setup-err-text: #D4574F;

    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    font-family: var(--font-family-body);
    font-weight: normal;
    font-style: normal;
    font-size: var(--font-size-md);
    line-height: 1.45;
    color: var(--color-text);
    background-color: #050506;
}

/* The backdrop: near black, lighter to the right, a faint glow and darker edges. */
setup-backdrop,
setup-vignette,
setup-glow {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

setup-backdrop {
    decorator: linear-gradient(to right, #030303 0%, #070708 45%, #121417 100%);
}

setup-vignette {
    decorator: radial-gradient(farthest-corner at 50% 45%, rgba(0, 0, 0, 0%) 40%, rgba(0, 0, 0, 80%) 100%);
}

setup-glow {
    decorator: radial-gradient(farthest-corner at 72% 40%, rgba(70, 78, 86, 35%) 0%, rgba(0, 0, 0, 0%) 55%);
}

/* The rail and the page. They fade in when the page opens and out when it closes. */
setup-shell {
    display: flex;
    flex-direction: row;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    filter: opacity(0);
    transition: filter 0.2s linear-in-out;
}

setup-shell[open] {
    filter: opacity(1);
}

setup-rail {
    display: flex;
    flex-direction: column;
    flex: 0 0 250dp;
    width: 250dp;
    box-sizing: border-box;
    padding: var(--space-2xl) var(--space-xl);
    gap: var(--space-2xl);
    border-right: 1dp var(--setup-line);
    background-color: rgba(0, 0, 0, 35%);
}

setup-brand {
    display: block;
}

setup-brand-name {
    display: block;
    font-family: var(--font-family-display);
    font-size: var(--font-size-4xl);
    letter-spacing: 2dp;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--color-accent);
}

setup-brand-rule {
    display: block;
    height: 1dp;
    width: 100%;
    margin-top: var(--space-md);
    decorator: linear-gradient(to right, rgb(var(--color-border-rgb)), rgba(var(--color-border-rgb), 0%));
}

setup-rail-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
}

setup-rail-step {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-sm);
    padding: 7dp var(--space-sm);
    border-left: 2dp rgba(0, 0, 0, 0%);
    font-size: var(--font-size-base);
    color: var(--setup-faint);
}

setup-rail-mark {
    display: block;
    flex: 0 0 auto;
    width: 16dp;
    height: 16dp;
    border: 1dp var(--setup-faint);
    border-radius: 9dp;
    font-size: 10dp;
    line-height: 16dp;
    text-align: center;
}

setup-rail-mark icon {
    display: block;
    width: 16dp;
    height: 16dp;
    font-size: 12dp;
}

setup-rail-text,
setup-rail-name,
setup-rail-sub {
    display: block;
}

setup-rail-sub {
    font-size: var(--font-size-2xs);
    color: var(--setup-faint);
}

setup-rail-step.done {
    color: var(--setup-muted);
}

setup-rail-step.done setup-rail-mark {
    border-color: var(--color-success);
    color: var(--color-success);
}

setup-rail-step.busy setup-rail-mark {
    border-color: rgba(var(--color-accent-rgb), 60%);
    color: var(--color-accent);
}

setup-rail-step.now {
    color: var(--color-accent);
    border-left-color: rgb(var(--color-interactive-rgb));
    decorator: linear-gradient(to right, rgba(var(--color-interactive-rgb), 12%), rgba(var(--color-interactive-rgb), 0%));
}

setup-rail-step.now setup-rail-mark {
    border-color: var(--color-accent);
}

setup-rail-space {
    display: block;
    flex: 1 1 auto;
}

setup-rail-foot {
    display: block;
    font-size: var(--font-size-2xs);
    color: var(--setup-faint);
    word-break: break-all;
}

setup-main {
    display: flex;
    flex-direction: column;
    flex: 1 1 0;
    min-width: 0;
    box-sizing: border-box;
    padding: var(--space-2xl) var(--space-2xl) var(--space-lg) var(--space-2xl);
}

setup-content {
    display: block;
    flex: 1 1 0;
    min-height: 0;
    padding-right: var(--space-lg);
    overflow: hidden auto;
}

/* The page's parts */
setup-body {
    display: block;
}

setup-title {
    display: block;
    margin-bottom: var(--space-sm);
    font-family: var(--font-family-display);
    font-size: 30dp;
    letter-spacing: 1.5dp;
    line-height: 1.15;
    color: var(--color-accent);
}

setup-lede {
    display: block;
    max-width: 640dp;
    margin-bottom: var(--space-xl);
    font-size: var(--font-size-lg);
    color: var(--setup-muted);
}

setup-heading {
    display: block;
    margin: var(--space-xl) 0 var(--space-md);
    font-family: var(--font-family-display);
    font-size: var(--font-size-base);
    letter-spacing: 2.5dp;
    text-transform: uppercase;
    color: var(--setup-muted);
}

setup-text {
    display: block;
    max-width: 680dp;
    margin-bottom: var(--space-md);
}

setup-note {
    display: block;
    font-size: var(--font-size-sm);
    color: var(--setup-muted);
}

setup-note.after {
    margin-top: 18dp;
}

setup-panel {
    display: block;
    max-width: 960dp;
    padding: var(--space-lg) var(--space-xl);
    border: 1dp var(--setup-line-soft);
    border-radius: var(--radius-panel);
    background-color: rgba(var(--color-surface-rgb), 92%);
}

setup-panel.stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
}

setup-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
}

/* A found row: a mark, what it is and its value, and a tag or a link on the right. */
setup-found {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: var(--space-md);
    padding: var(--space-md) 0;
    border-bottom: 1dp var(--setup-line);
}

setup-found:last-child {
    border-bottom-width: 0;
}

setup-found > icon {
    flex: 0 0 auto;
    width: 18dp;
    height: 18dp;
    margin-top: 3dp;
    font-size: 18dp;
}

setup-found-text,
setup-found-key,
setup-found-value {
    display: block;
}

setup-found-text {
    flex: 1 1 0;
    min-width: 0;
}

setup-found-value {
    font-size: var(--font-size-sm);
    color: var(--setup-muted);
    word-break: break-all;
}

setup-tag {
    display: block;
    flex: 0 0 auto;
    padding: 2dp var(--space-sm);
    border: 1dp;
    border-radius: var(--radius-small);
    font-size: var(--font-size-2xs);
    letter-spacing: 1dp;
    text-transform: uppercase;
}

setup-tag.ok { color: var(--color-success); border-color: var(--color-success); }
setup-tag.info { color: var(--color-info); border-color: var(--color-info); }
setup-tag.warn { color: var(--color-warning); border-color: var(--color-warning); }
setup-tag.err { color: var(--setup-err-text); border-color: var(--setup-err-text); }
setup-tag.muted { color: var(--setup-faint); border-color: var(--setup-faint); }

/* A callout: a framed note with a mark, a title and a line, in the colour of what it says. */
setup-callout {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: var(--space-md);
    max-width: 960dp;
    padding: var(--space-md) var(--space-lg);
    border: 1dp;
    border-radius: var(--radius-small);
}

setup-callout.err {
    border-color: rgba(var(--color-error-rgb), 70%);
    background-color: rgba(var(--color-error-rgb), 8%);
}

setup-callout.warn {
    border-color: rgba(var(--color-warning-rgb), 50%);
    background-color: rgba(var(--color-warning-rgb), 6%);
}

setup-callout.info {
    border-color: rgba(var(--color-info-rgb), 40%);
    background-color: rgba(var(--color-info-rgb), 5%);
}

setup-callout > icon {
    flex: 0 0 auto;
    width: 18dp;
    height: 18dp;
    margin-top: 3dp;
    font-size: 18dp;
}

setup-callout-body,
setup-callout-title,
setup-callout-text {
    display: block;
}

setup-callout-body {
    flex: 1 1 0;
    min-width: 0;
}

setup-callout-title {
    margin-bottom: var(--space-2xs);
}

setup-callout-text {
    font-size: var(--font-size-sm);
    color: var(--setup-muted);
}

/* The engine's last lines. (The UI has no fixed-width font: the body font, smaller.) */
setup-log {
    display: block;
    max-width: 960dp;
    max-height: 150dp;
    margin-top: var(--space-md);
    padding: var(--space-md);
    border: 1dp rgba(var(--color-border-rgb), 20%);
    background-color: #000000;
    font-size: var(--font-size-xs);
    line-height: 1.4;
    color: var(--setup-muted);
    word-break: break-all;
    overflow: hidden auto;
}

setup-field {
    display: block;
    margin-top: 10dp;
    padding: var(--space-sm) var(--space-md);
    border: 1dp var(--setup-line-soft);
    background-color: rgba(0, 0, 0, 50%);
    font-size: var(--font-size-xs);
    word-break: break-all;
}

/* Marks */
icon.setup-ok { decorator: text("&#xe86c;" center center); color: var(--color-success); }    /* check_circle */
icon.setup-err { decorator: text("&#xe5c9;" center center); color: var(--setup-err-text); }  /* cancel */
icon.setup-warn { decorator: text("&#xe002;" center center); color: var(--color-warning); }  /* warning */
icon.setup-info { decorator: text("&#xe88e;" center center); color: var(--color-info); }     /* info */
icon.setup-wait { decorator: text("&#xe836;" center center); color: var(--setup-faint); }    /* radio_button_unchecked */
icon.setup-tick { decorator: text("&#xe5ca;" center center); }                               /* check */

/* The spinner: the progress_activity glyph, turning. Not a ring of border: RmlUi draws borders without smoothing,
   so a small round one comes out uneven; a glyph is smoothed. */
setup-spin {
    display: block;
    width: 18dp;
    height: 18dp;
    font-family: var(--font-family-icons);
    font-weight: normal;
    font-size: 18dp;
    line-height: 1;
    color: var(--color-accent);
    decorator: text("&#xe9d0;" center center);  /* progress_activity */
    animation: 1s linear-in-out infinite setup-spin;
}

@keyframes setup-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

/* The build's bar and its list of tasks */
setup-percent,
setup-eta {
    display: block;
}

setup-eta {
    font-size: var(--font-size-sm);
    color: var(--setup-muted);
}

progress.setup-meter {
    height: 8dp;
    border-radius: 1dp;
    background-color: rgba(var(--color-border-rgb), 18%);
}

progress.setup-meter fill {
    border-radius: 1dp;
    background-color: rgba(0, 0, 0, 0%);
    decorator: linear-gradient(to right, rgba(var(--color-interactive-rgb), 55%), rgb(var(--color-accent-rgb)));
}

progress.setup-meter.fail fill {
    decorator: none;
    background-color: var(--color-error);
}

setup-tasks {
    display: flex;
    flex-direction: column;
}

setup-task {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-md);
    padding: 9dp 0;
    border-bottom: 1dp rgba(var(--color-border-rgb), 12%);
    color: var(--setup-faint);
}

setup-task:last-child {
    border-bottom-width: 0;
}

setup-task.run { color: var(--color-accent); }
setup-task.done { color: var(--setup-muted); }
setup-task.fail { color: var(--setup-err-text); }

setup-task-mark {
    display: block;
    flex: 0 0 22dp;
    width: 22dp;
}

setup-task-mark icon {
    display: block;
    width: 18dp;
    height: 18dp;
    font-size: 18dp;
}

setup-task-text,
setup-task-name,
setup-task-sub,
setup-task-num {
    display: block;
}

setup-task-text {
    flex: 1 1 0;
    min-width: 0;
}

setup-task-sub {
    font-size: var(--font-size-xs);
    color: var(--setup-faint);
}

setup-task-num {
    flex: 0 0 auto;
    font-size: var(--font-size-sm);
    color: var(--setup-muted);
}

/* Buttons: in Cinzel capitals, framed in silver. Primary is the one thing to do, Danger what cannot be undone,
   Quiet a way out. The pad's focus lights a button as the mouse does. */
setup-actions {
    display: flex;
    flex-flow: row wrap;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-xl);
}

setup-actions.first {
    margin-top: 0;
}

setup-actions setup-note {
    flex: 1 1 200dp;
}

button.setup-btn {
    display: block;
    padding: 10dp 22dp;
    border-radius: var(--radius-small);
    font-family: var(--font-family-display);
    font-size: var(--font-size-base);
    letter-spacing: 1.5dp;
    text-transform: uppercase;
    color: var(--color-text);
    background-color: rgba(var(--color-control-rgb), 60%);
    box-shadow: rgb(var(--color-border-rgb)) 0 0 0 1dp;
    opacity: 1;
    transition: background-color 0.12s linear-in-out;
}

button.setup-btn:not(:disabled):hover,
button.setup-btn:not(:disabled):focus-visible {
    color: #FFFFFF;
    background-color: rgba(var(--color-interactive-rgb), 12%);
    box-shadow: rgb(var(--color-interactive-rgb)) 0 0 0 1dp, rgba(var(--color-interactive-rgb), 30%) 0 0 12dp 0;
}

button.setup-btn.primary {
    color: var(--color-accent);
    background-color: rgba(var(--color-interactive-rgb), 10%);
    box-shadow: rgb(var(--color-accent-rgb)) 0 0 0 1dp, rgba(var(--color-interactive-rgb), 8%) 0 0 18dp 0;
}

button.setup-btn.primary:not(:disabled):hover,
button.setup-btn.primary:not(:disabled):focus-visible {
    color: #FFFFFF;
    background-color: rgba(var(--color-interactive-rgb), 20%);
    box-shadow: rgb(var(--color-accent-rgb)) 0 0 0 1dp, rgba(var(--color-interactive-rgb), 35%) 0 0 16dp 0;
}

button.setup-btn.danger {
    color: var(--setup-err-text);
    box-shadow: var(--color-danger-border) 0 0 0 1dp;
}

button.setup-btn.danger:not(:disabled):hover,
button.setup-btn.danger:not(:disabled):focus-visible {
    color: #E8837C;
    background-color: rgba(var(--color-error-rgb), 18%);
    box-shadow: rgb(var(--color-error-rgb)) 0 0 0 1dp, rgba(var(--color-error-rgb), 35%) 0 0 12dp 0;
}

button.setup-btn.quiet {
    padding: 10dp var(--space-sm);
    color: var(--setup-muted);
    background-color: rgba(0, 0, 0, 0%);
    box-shadow: none;
}

button.setup-btn.quiet:not(:disabled):hover,
button.setup-btn.quiet:not(:disabled):focus-visible {
    color: var(--color-accent);
    background-color: rgba(var(--color-interactive-rgb), 6%);
    box-shadow: rgba(var(--color-interactive-rgb), 45%) 0 0 0 1dp;
}

button.setup-btn:disabled {
    opacity: 0.45;
}

/* The pad's buttons, small, at the bottom of the page */
setup-hints {
    display: flex;
    flex-flow: row wrap;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--space-xs) var(--space-lg);
    padding-top: var(--space-md);
    font-size: var(--font-size-xs);
    color: var(--setup-faint);
}

setup-hint {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-xs);
}

setup-hint icon {
    width: 1.3em;
    height: 1.3em;
    font-size: 1.3em;
}

setup-hint-label,
setup-hint-action {
    display: block;
}

setup-hint-label {
    padding: 0 var(--space-xs);
    border: 1dp var(--setup-line-soft);
    border-radius: 3dp;
}

/* A question over the page (Stop the build?), with the page dimmed behind it */
setup-layer {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 72%);
}

setup-layer[open] {
    display: flex;
    align-items: center;
    justify-content: center;
}

setup-question {
    display: block;
    width: 560dp;
    max-width: 90%;
    box-sizing: border-box;
    padding: var(--space-xl);
    border: 1dp var(--color-border);
    border-radius: var(--radius-panel);
    background-color: rgb(var(--color-surface-rgb));
    box-shadow: rgba(0, 0, 0, 70%) 0 10dp 40dp 0;
}

setup-question-title {
    display: block;
    margin-bottom: var(--space-md);
    font-family: var(--font-family-display);
    font-size: var(--font-size-2xl);
    letter-spacing: 1dp;
    color: var(--color-accent);
}

setup-question-text {
    display: block;
    font-size: var(--font-size-sm);
    color: var(--setup-muted);
}

@media (max-width: 900dp) {
    setup-rail {
        flex: 0 0 200dp;
        width: 200dp;
        padding: var(--space-xl) var(--space-lg);
    }

    setup-main {
        padding: var(--space-xl) var(--space-lg) var(--space-md) var(--space-xl);
    }

    setup-title {
        font-size: var(--font-size-4xl);
    }
}
