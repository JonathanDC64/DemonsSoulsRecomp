# Copy to tools/des/local.env (gitignored) and fill in for this machine.
# Sourced by deslib.sh, build.sh, milestones.sh, repro.sh, rlog.sh and
# tools/ghidra/dump.sh. Every entry is optional except where a tool says so.

# Disc root holding PS3_GAME (default: work/disc).
#PS3_VFS_ROOT="D:/games/ps3/BLUS30443"   # keep an existing value: [ -n "${PS3_VFS_ROOT:-}" ] || PS3_VFS_ROOT=...

# Ninja's directory, when it is not on PATH; vcvars64.bat, when Visual Studio
# Build Tools 2022 is not in its default place.
#NINJA_DIR="/c/tools/ninja"
#VCVARS="C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Auxiliary/Build/vcvars64.bat"

# RPCS3 install (rlog.sh reads $RPCS3_DIR/log/RPCS3.log) and Ghidra install
# (tools/ghidra/dump.sh).
#RPCS3_DIR="/c/emulators/rpcs3"
#GHIDRA_DIR="/c/tools/ghidra_12.1.2_PUBLIC"

# Perf batches (exeab.sh, knobab.sh, regfps.sh; see PERF.md). The quiet check
# allows this much total CPU before a boot (default 30). To also bound what
# everything else uses, name the processes that belong to the batch (and to
# whatever starts it) and the most the rest may use, in %.
#PERF_QUIET_MAX=30
#PERF_QUIET_OURS="bash,sh,powershell,python,conhost,git,tasklist,timeout,Code"
#PERF_QUIET_OUT=3
